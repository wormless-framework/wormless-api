<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!--
        Exposição de referências internas em DTOs e entidades.
        Esses acessos são intencionais no modelo JPA/Lombok.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
        <Class name="~.*\.dto\..*" />
    </Match>

    <!--
        Entidades JPA:
        getters/setters de relacionamentos e coleções são necessários
        para o funcionamento e mapeamento das entidades.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
        <Class name="com.wormless.entities.*" />
    </Match>

    <!--
        Classes geradas (ex: MapStruct, Lombok @Builder)
        não precisam de análise.
    -->
    <Match>
        <Class name="~.*MapperImpl" />
    </Match>

    <!--
        Exemplo: ignorar um bug específico em uma classe específica.
    -->
    <!--
    <Match>
        <Class name="com.exemplo.sgam.service.ArquivoService" />
        <Bug pattern="SE_BAD_FIELD" />
    </Match>
    -->

</FindBugsFilter>