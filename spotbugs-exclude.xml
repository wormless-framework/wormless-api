<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!-- Exposição intencional de referências em DTOs. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
        <Class name="~.*\.dto\..*" />
    </Match>

    <!-- Getters e setters de relacionamentos e coleções são necessários no JPA. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
        <Class name="~com\.wormless\.entities\..*" />
    </Match>

    <!-- Classes geradas, como implementações de mappers. -->
    <Match>
        <Class name="~.*MapperImpl" />
    </Match>

    <!-- O filtro é um bean gerenciado pelo Spring e armazenado pela configuração de segurança. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2" />
        <Class name="com.wormless.security.SecurityConfig" />
    </Match>

    <!-- A construção da chave valida a configuração e deve falhar rápido se o segredo for inválido. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW" />
        <Class name="com.wormless.security.JwtService" />
    </Match>

    <!-- O construtor gerado pelo Lombok apenas injeta dependências nos serviços Spring. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW" />
        <Class name="com.wormless.services.SandboxService" />
    </Match>
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW" />
        <Class name="com.wormless.services.AnaliseIAServiceImpl" />
    </Match>
    <!-- ObjectMapper é um singleton configurado pelo Spring e injetado no serviço. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2" />
        <Class name="com.wormless.services.AnaliseIAServiceImpl" />
    </Match>

</FindBugsFilter>
